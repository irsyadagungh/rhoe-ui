{
  "name": "rhoe-ui",
  "version": "0.1.0",
  "description": "Free, open source React components with motion built in. Install with the shadcn CLI or copy the code.",
  "license": "MIT",
  "homepage": "https://rhoe.syadah.my.id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irsyadagungh/rhoe-ui.git"
  },
  "bugs": {
    "url": "https://github.com/irsyadagungh/rhoe-ui/issues"
  },
  "type": "module",
